# Connect to Supabase via connection pooling (pgbouncer, port 6543) — для рантайма приложения
# Get it from: Supabase → Project Settings → Database → Connection pooling → Transaction mode
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection — для Prisma миграций (prisma migrate deploy)
# Get it from: Supabase → Project Settings → Database → Connection pooling → Session mode
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# ── Telegram notifications ────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=""
# Comma-separated list of chat_ids that will receive new application alerts.
# How to get your chat_id:
#   1. Start a conversation with your bot (or add it to a group)
#   2. Send any message
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and find "chat":{"id": XXXX}
TELEGRAM_NOTIFY_CHAT_IDS=""
