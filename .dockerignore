# Dependencies — re-installed inside Docker
node_modules

# Next.js build output — built inside Docker
.next

# Local environment — values are injected at deploy time by Timeweb
.env
.env.local
.env.*.local

# SQLite WAL/SHM temp files (never needed in image)
*.db-shm
*.db-wal
# Empty placeholder only
prisma/*.db
# dev.db IS included — needed during build (pre-rendering) and baked into image

# Dev / IDE
.git
.gitignore
.cursor
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Tests / docs
__tests__
*.test.ts
*.spec.ts
README.md
